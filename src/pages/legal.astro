---
// Legal notice (Impressum) of the private operator of this website.
import Base from "@layouts/Base.astro";
import { siteConfig } from "~/settings";
import { t } from "~/i18n";

const { legal } = t;
const { operator } = siteConfig;
---

<Base title={legal.title}>
  <article class="container page">
    <h1>{legal.heading}</h1>
    <section>
      <h2>{legal.operatorHeading}</h2>
      <address>
        {operator.name}
        <br />
        {operator.street}
        <br />
        {operator.town}
        <br />
        {legal.country}
        <br />
        {legal.emailLabel}:{" "}
        <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      </address>
      <p>{legal.note}</p>
    </section>
    {legal.sections.map(({ heading, paragraphs }) => (
      <section>
        <h2>{heading}</h2>
        {paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </section>
    ))}
  </article>
</Base>
