---
import { render } from "astro:content";
import Base from "@layouts/Base.astro";
import BlogPost from "@layouts/BlogPost.astro";
import { getPosts, type Post } from "~/lib/blog";
import { otherLocale } from "~/i18n";

export async function getStaticPaths() {
  const posts = await getPosts();
  // The language switch links to the translated post, or to the blog index if there is none.
  const translated = new Set(
    (await getPosts(otherLocale)).map((post) => post.slug),
  );
  return posts.map((post) => ({
    params: { id: post.slug },
    props: {
      post,
      alternatePath: translated.has(post.slug)
        ? `/blog/${post.slug}/`
        : "/blog/",
    },
  }));
}

interface Props {
  post: Post;
  alternatePath: string;
}

const { post, alternatePath } = Astro.props;
const { Content } = await render(post);
---

<Base
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  alternatePath={alternatePath}
>
  <BlogPost {...post.data}>
    <Content />
  </BlogPost>
</Base>
