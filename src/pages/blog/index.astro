---
import Base from "@layouts/Base.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { getPosts, type Post } from "~/lib/blog";
import { t } from "~/i18n";

const posts = await getPosts();

const postsByYear = new Map<number, Post[]>();
for (const post of posts) {
  const year = post.data.pubDate.getUTCFullYear();
  postsByYear.set(year, [...(postsByYear.get(year) ?? []), post]);
}
---

<Base title={t.blog.title} description={t.blog.lead}>
  <article class="container page">
    <h1>{t.blog.title}</h1>
    <p class="lead">{t.blog.lead}</p>
    {
      [...postsByYear].map(([year, yearPosts]) => (
        <section id={String(year)}>
          <h2>{year}</h2>
          <ul class="post-list">
            {yearPosts.map((post) => (
              <li>
                <FormattedDate date={post.data.pubDate} />
                <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </article>
</Base>
