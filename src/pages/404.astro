---
import Base from "@layouts/Base.astro";
import { t } from "~/i18n";
---

<Base title={t.notFound.title} alternatePath="/">
  <section class="container page not-found">
    <h1>404: {t.notFound.title}</h1>
    <p>{t.notFound.text}</p>
    <p><a href="/" class="btn">{t.notFound.link}</a></p>
  </section>
</Base>
