---
// Page frame for every page: head metadata, header, main content and footer.
import "@assets/jumpbit-theme.css";
import "@styles/site.css";
import { siteConfig } from "~/settings";
import { LOCALES, locale } from "~/i18n";

import PageHead from "@components/PageHead.astro";
import PageHeader from "@components/PageHeader.astro";
import PageFooter from "@components/PageFooter.astro";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  /** Path of this page on the other language's website; defaults to the same path. */
  alternatePath?: string;
}

const {
  title,
  description,
  ogType = "website",
  alternatePath = Astro.url.pathname,
} = Astro.props;
---

<!doctype html>
<html lang={LOCALES[locale].htmlLang}>
  <PageHead
    title={title ? `${title} | ${siteConfig.title}` : siteConfig.title}
    description={description}
    ogType={ogType}
    alternatePath={alternatePath}
  />
  <body>
    <PageHeader alternatePath={alternatePath} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <PageFooter />
  </body>
</html>
