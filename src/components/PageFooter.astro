---
// Site footer: copyright, contact e-mail and links to the legal pages.
import { siteConfig } from "~/settings";
import { LOCALES, locale, t } from "~/i18n";

const currentYear = new Date().getFullYear();
const domain = new URL(LOCALES[locale].siteUrl).host;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p>
      &copy; 2024&ndash;{currentYear}
      {siteConfig.title} &middot; {domain} &middot;
      <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
    </p>
    <nav aria-label={t.footer.label}>
      <ul>
        <li><a href="/contact/">{t.nav.contact}</a></li>
        <li><a href="/legal/">{t.footer.legal}</a></li>
        <li><a href="/privacy/">{t.footer.privacy}</a></li>
      </ul>
    </nav>
  </div>
</footer>
