---
// Document head: metadata, icons, language alternates and Open Graph tags.
import { siteConfig } from "~/settings";
import { LOCALES, locale, localizedUrl, otherLocale, t } from "~/i18n";

interface Props {
  title: string;
  description?: string | undefined;
  ogType?: "website" | "article";
  alternatePath: string;
}

const {
  title,
  description = t.meta.description,
  ogType = "website",
  alternatePath,
} = Astro.props;

const canonicalURL = localizedUrl(locale, Astro.url.pathname);
const alternateURL = localizedUrl(otherLocale, alternatePath);
const socialImageURL = localizedUrl(locale, siteConfig.og.image);
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  {/* Language versions: jumpbit.com (English) and jumpbit.ch (German) */}
  <link
    rel="alternate"
    hreflang={LOCALES[locale].htmlLang}
    href={canonicalURL}
  />
  <link
    rel="alternate"
    hreflang={LOCALES[otherLocale].htmlLang}
    href={alternateURL}
  />
  <link
    rel="alternate"
    hreflang="x-default"
    href={locale === "en" ? canonicalURL : alternateURL}
  />

  {/* Icons; bump ?v= when they change, browsers cache favicons separately and for a long time */}
  <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#323232" />

  <link
    rel="alternate"
    type="application/rss+xml"
    title={siteConfig.title}
    href={localizedUrl(locale, "/rss.xml")}
  />

  {/* Open Graph */}
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={siteConfig.title} />
  <meta property="og:locale" content={LOCALES[locale].ogLocale} />
  <meta
    property="og:locale:alternate"
    content={LOCALES[otherLocale].ogLocale}
  />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={socialImageURL} />
  <meta property="og:image:type" content={siteConfig.og.imageType} />
  <meta property="og:image:alt" content={t.meta.ogImageAlt} />
  <meta property="og:image:width" content={siteConfig.og.imageWidth} />
  <meta property="og:image:height" content={siteConfig.og.imageHeight} />
</head>
