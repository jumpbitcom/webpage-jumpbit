---
import TagLink from "@components/TagLink.astro";
import { t } from "~/i18n";

type Props = {
  tags: string[];
};

const { tags } = Astro.props;
---

<nav class="tag-list" aria-label={t.blog.tags}>
  <ul>
    {
      tags.map((tag) => (
        <li>
          <TagLink tag={tag} />
        </li>
      ))
    }
  </ul>
</nav>
