# Copy to .env for local overrides. Nothing here is secret; the defaults are the production domains.
# The language (SITE_LOCALE) is set by the npm scripts: "npm run dev" is English, "npm run dev:de" German.

# Base URLs the language switch links to. Point them at both dev servers to test switching locally.
# SITE_URL_EN=http://localhost:4321
# SITE_URL_DE=http://localhost:4322
