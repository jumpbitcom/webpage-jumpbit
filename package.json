{
  "name": "webpage-jumpbit",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "node scripts/astro-locale.mjs en dev",
    "dev:de": "node scripts/astro-locale.mjs de dev --port 4322",
    "start": "npm run dev",
    "check": "astro check",
    "build": "astro check && npm run build:en && npm run build:de",
    "build:en": "node scripts/astro-locale.mjs en build",
    "build:de": "node scripts/astro-locale.mjs de build",
    "preview": "node scripts/astro-locale.mjs en preview",
    "preview:de": "node scripts/astro-locale.mjs de preview --port 4322",
    "astro": "astro",
    "format": "prettier './src/**/*' --write",
    "format:check": "prettier './src/**/*' --check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.4.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
